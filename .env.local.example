# LLM
LLM_PROVIDER=ollama
LLM_PRESET_ID=ollama-lan-qwen36
LLM_PRESETS_PATH=config/llm-presets.json
LLM_TASK_PROFILES_PATH=config/llm-task-profiles.json
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Image
IMAGE_PROVIDER=comfyui
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_TXT2IMG=workflows/文生图Zimage.json
COMFYUI_ZIMAGE_ASPECT_RATIO=9:16 (Slim Vertical)
COMFYUI_ZIMAGE_WIDTH=1080
COMFYUI_ZIMAGE_HEIGHT=1920
COMFYUI_WORKFLOW_IMG2IMG=workflows/img2img.json
COMFYUI_CHARACTER_BASE_URL=http://192.168.0.100:8188
COMFYUI_WORKFLOW_CHARACTER=workflows/角色设定三视图加特写_自动补提示词.json
COMFYUI_WORKFLOW_CAPTION=workflows/caption.json
SEEDANCE_BASE_URL=https://api.dramaplay.dev/v1
SEEDANCE_API_KEY=

# Video
VIDEO_PROVIDER=seedance
COMFYUI_WORKFLOW_TXT2VIDEO=workflows/txt2video.json
COMFYUI_WORKFLOW_IMG2VIDEO=workflows/img2video.json

# Upload / fallback
UPLOAD_DIR=public/uploads
ENABLE_MOCK_GENERATION=true
