# LLM
LLM_PROVIDER=ollama
LLM_PRESET_ID=ollama-lan-qwen36
LLM_PRESETS_PATH=config/llm-presets.json
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Image
IMAGE_PROVIDER=comfyui
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_TXT2IMG=workflows/txt2img.json
COMFYUI_WORKFLOW_IMG2IMG=workflows/img2img.json
COMFYUI_WORKFLOW_CAPTION=workflows/caption.json
SEEDANCE_BASE_URL=https://api.dramaplay.dev/v1
SEEDANCE_API_KEY=

# Video
VIDEO_PROVIDER=seedance
COMFYUI_WORKFLOW_TXT2VIDEO=workflows/txt2video.json
COMFYUI_WORKFLOW_IMG2VIDEO=workflows/img2video.json

# Upload / fallback
UPLOAD_DIR=public/uploads
ENABLE_MOCK_GENERATION=true
